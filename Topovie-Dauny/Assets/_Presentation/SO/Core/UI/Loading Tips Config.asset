  m_Script: {fileID: 11500000, guid: 1021892515c14873bd18ead094ee8cf8, type: 3}
  m_Name: Loading Tips Config
  m_EditorClassIdentifier: 
  <Tips>k__BackingField:
  - "\u0427\u0442\u043E\u0431\u044B \u0445\u043E\u0434\u0438\u0442\u044C \u0432\u0441\u0442\u0430\u043D\u044C
    \u0441\u043E \u0441\u0442\u0443\u043B\u0430 \u0438 \u0432\u044B\u0439\u0434\u0438
    \u043D\u0430\u0445\u0443\u0439."
  - "\u041D\u0438\u043A\u0430\u043A \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
    \u043E\u0434\u043E\u043B\u0435\u0442\u044C \u0431\u043E\u0441\u0441\u0430 \u041B\u0435\u043E?
    \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0443\u0434\u0430\u043B\u0438\u0442\u044C
    \u0438\u0433\u0440\u0443. \u041B\u043E\u0445."
  - "\u041F\u0440\u043E\u0431\u0443\u0439 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0440\u0430\u0437\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0438\u0437 \u0431\u0430\u0440\u0430\u0445\u043E\u043B\u043A\u0438 \u041C\u0430\u0440\u0442\u044B!
    \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043B\u0430\u0441\u0442\u0438\u043A,
    \u043E\u043D \u0434\u043B\u044F \u0441\u043B\u0430\u0431\u044B\u0445."
  - "\u0410 \u0442\u044B \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0434\u043B\u044F
    \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B \u0431\u0440\u043E\u0441\u0438\u0442\u044C
    \u0431\u043E\u043C\u0431\u0443, \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u043A\u043D\u043E\u043F\u043A\u0443 \u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F?
    \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0432 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043E\u0442\u0447\u0438\u043C\u0430."
