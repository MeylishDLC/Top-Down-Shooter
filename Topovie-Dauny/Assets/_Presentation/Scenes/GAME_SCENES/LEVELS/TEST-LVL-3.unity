    - target: {fileID: 6312261517619840915, guid: 11c6617fe4209fd489cbb1f9cd2be06d, type: 3}
      propertyPath: dialogueText
      value: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043A \u0410\u0439\u0431\u043E\u043B\u0438\u0442\u0443
        \u043F\u0440\u0438\u0448\u043B\u0430 \u0441\u043E\u0431\u0430\u0447\u043A\u0430
        \u0441 \u043F\u0440\u043E\u0441\u044C\u0431\u043E\u0439 \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C
        \u0435\u0451 \u043E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0439
        \u0431\u043E\u043B\u0435\u0437\u043D\u0438 \u2014 \u0436\u0435\u043B\u0430\u043D\u0438\u044F
        \u0432\u0441\u0451 \u0438 \u0432\u0441\u0435\u0445 \u043A\u0443\u0441\u0430\u0442\u044C.
        \u041D\u043E \u0410\u0439\u0431\u043E\u043B\u0438\u0442, \u0431\u0443\u0434\u0443\u0447\u0438
        \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u043C\u043D\u044B\u043C,
        \u043D\u043E \u0438 \u043C\u0443\u0434\u0440\u044B\u043C, \u043F\u043E\u043D\u044F\u043B:
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0442\u0443\u0442
        \u043D\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442"
      objectReference: {fileID: 0}
